# Public app configuration. Never put an OpenAI API key in this file.
EXPO_PUBLIC_API_URL=https://community-report-api.onrender.com

# Use the same value as APP_ACCESS_TOKEN on the deployed backend.
# This client credential is bundled into the app and is not a true secret.
# Protect the backend with rate limits and rotate this value if it is abused.
EXPO_PUBLIC_FIXMOCO_CLIENT_TOKEN=